{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "ES6",
    "jsx": "react-native",
    "checkJs": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["*",],
      "@/utils/*": ["utils/*"],
      "@/validation/*": ["validation/*"],
      "@/styles/*": ["styles/*"],
      "@/context/*": ["context/*"],
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
, "firebaseConfig.js"  ]
}
